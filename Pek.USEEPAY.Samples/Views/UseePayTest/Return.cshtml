@{
    ViewBag.Title = "支付完成";
    Layout = "_Root";
}

<div style="padding: 20px; max-width: 800px; margin: 0 auto; text-align: center;">
    <div style="background: white; padding: 40px; border-radius: 10px; box-shadow: 0 2px 12px rgba(0,0,0,0.1);">
        <div style="font-size: 64px; color: #67C23A; margin-bottom: 20px;">
            ✓
        </div>
        <h1 style="color: #333; margin-bottom: 10px;">@ViewBag.Message</h1>
        <p style="color: #666; margin-bottom: 30px;">您的支付已经处理完成</p>

        <div style="margin: 30px 0;">
            <a href="/UseePayTest/Index" style="display: inline-block; padding: 12px 40px; background: #409EFF; color: white; text-decoration: none; border-radius: 5px;">
                返回测试页面
            </a>
        </div>

        <div style="background: #f5f5f5; padding: 20px; margin-top: 30px; border-radius: 5px; text-align: left;">
            <h3>提示：</h3>
            <p>这是一个测试页面，实际的支付返回处理需要：</p>
            <ul style="padding-left: 20px;">
                <li>验证支付回调签名</li>
                <li>更新订单状态</li>
                <li>记录支付日志</li>
                <li>返回用户友好的结果页面</li>
            </ul>
        </div>
    </div>
</div>
